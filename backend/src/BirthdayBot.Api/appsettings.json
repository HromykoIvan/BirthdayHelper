{
  "Bot": {
    "Token": "REPLACE_WITH_ENV_TELEGRAM_BOT_TOKEN",
    "WebhookSecretToken": "REPLACE_WITH_ENV_TELEGRAM_WEBHOOK_SECRET"
  },
  "Mongo": {
    "ConnectionString": "mongodb://127.0.0.1:27017/birthdays?directConnection=true",
    "Database": "birthdaybot"
  },
  "Reminder": {
    "Cron": "* * * * *",
    "RunAsHostedService": true
  },
  "Metrics": {
    "Enable": true,
    "ScrapeEndpoint": "/metrics"
  },
  "AiEval": {
    "EnableEndpoints": false
  },
  "PromptProfiles": {
    "IntentPromptVersion": "intent-v2-openai",
    "GreetingPromptVersion": "greeting-v2-openai"
  },
  "UserRateLimit": {
    "Enable": true,
    "WindowSeconds": 30,
    "MaxUpdatesPerWindow": 15
  },
  "LocalAi": {
    "Enable": true,
    "UseOllama": true,
    "BaseUrl": "http://ollama:11434",
    "Model": "qwen2.5:7b-instruct",
    "TimeoutSeconds": 8,
    "MaxPromptChars": 1200
  },
  "Scheduler": {
    "Secret": ""
  },
  "OpenAi": {
    "Enable": false,
    "ApiKey": "REPLACE_WITH_ENV_OPENAI_API_KEY",
    "BaseUrl": "https://api.openai.com/v1/",
    "IntentModel": "gpt-6-luna",
    "GreetingModel": "gpt-6-luna",
    "TimeoutSeconds": 20,
    "MaxOutputTokens": 900
  }
}
