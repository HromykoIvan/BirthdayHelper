{$DOMAIN:bday-bot.duckdns.org} {
  # Telegram webhook endpoint
  handle /telegram/webhook {
    reverse_proxy app:8080
  }

  # mongo-express web UI (protected by its own basic auth)
  @mongo path /mongo /mongo/*
  handle @mongo {
    reverse_proxy mongo-express:8081
  }

  # Grafana UI
  @grafana path /grafana /grafana/*
  handle @grafana {
    uri strip_prefix /grafana
    reverse_proxy grafana:3000
  }

  # Keep metrics private: Prometheus scrapes app:8080 internally.
  @metrics path /metrics
  respond @metrics 403

  # Everything else goes to the bot API (health, metrics, etc.)
  handle {
    reverse_proxy app:8080
  }
}

